    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Madushan Dissanayake"
            VALUE "FileDescription",  "CeylonDemon - UCI Chess Engine"
            VALUE "FileVersion",      "3.3"
            VALUE "InternalName",     "ceylondemon"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Madushan Dissanayake. GNU GPL v3 or later."
            VALUE "OriginalFilename", "CeylonDemon-3.3-x86-64-avx2.exe"
            VALUE "ProductName",      "CeylonDemon"
            VALUE "ProductVersion",   "3.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
